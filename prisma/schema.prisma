// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLED
  PAYMENT_RECEIVED
}

enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  EXPIRED
  CANCELED
}

model User {
  id        String   @id
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  employee    Employee?

  @@index([email])
}

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  tradeName              String?
  contactEmail           String?
  phone                  String?
  whatsapp               String?
  website                String?
  addressLine            String?
  city                   String?
  state                  String?
  zipCode                String?
  appointmentSlotMinutes Int?
  locale                 String?
  currency               String?
  timezone               String?
  dateFormat             String?
  timeFormat             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  customers     Customer[]
  services      Service[]
  employees     Employee[]
  appointments  Appointment[]
  transactions  Transaction[]
  businessHours BusinessHours[]
  notifications Notification[]
  subscription  Subscription?
}

model Membership {
  id             String         @id @default(cuid())
  role           MembershipRole @default(MEMBER)
  userId         String
  organizationId String
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  transactions  Transaction[]
  notifications Notification[]

  @@index([organizationId])
}

model Service {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  durationMin    Int
  price          Decimal  @db.Decimal(10, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([organizationId])
}

model Employee {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  @unique
  name           String
  role           String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])
  appointments Appointment[]

  @@index([organizationId])
}

model Appointment {
  id             String            @id @default(cuid())
  organizationId String
  customerId     String
  serviceId      String
  employeeId     String
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(SCHEDULED)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [customerId], references: [id])
  service       Service        @relation(fields: [serviceId], references: [id])
  employee      Employee       @relation(fields: [employeeId], references: [id])
  transactions  Transaction[]
  notifications Notification[]

  @@index([organizationId, startsAt])
  @@index([employeeId, startsAt])
  @@index([customerId])
}

model Transaction {
  id             String          @id @default(cuid())
  organizationId String
  type           TransactionType
  amount         Decimal         @db.Decimal(10, 2)
  category       String
  description    String?
  occurredAt     DateTime        @default(now())
  appointmentId  String?
  customerId     String?
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])

  @@index([organizationId, occurredAt])
}

model BusinessHours {
  id             String   @id @default(cuid())
  organizationId String
  weekday        Weekday
  isOpen         Boolean  @default(false)
  opensAt        String?
  closesAt       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, weekday])
  @@index([organizationId])
}

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  appointmentId  String?
  customerId     String?
  channel        NotificationChannel
  type           NotificationType
  status         NotificationStatus  @default(PENDING)
  recipient      String
  subject        String?
  message        String
  sentAt         DateTime?
  error          String?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([appointmentId])
  @@index([customerId])
}

model Subscription {
  id               String             @id @default(cuid())
  organizationId   String             @unique
  plan             SubscriptionPlan   @default(FREE)
  status           SubscriptionStatus @default(TRIAL)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  canceledAt       DateTime?

  // Dados do gateway de pagamento (Stripe). Atualizados exclusivamente
  // pelo webhook — nunca escritos otimisticamente fora dele.
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?
  stripePriceId        String?
  subscriptionStatus   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
}

/**
 * Registro de eventos de webhook já processados, usado pra idempotência
 * explícita: antes de processar um evento, o webhook tenta criar um
 * registro aqui; se a constraint única disparar, o evento já foi
 * processado (ou está sendo processado agora) e é ignorado com segurança.
 */
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}
